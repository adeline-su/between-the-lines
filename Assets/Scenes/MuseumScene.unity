  json: '{"Options":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":2}],"EditorInfo":{"isRoot":false,"xPos":185.75,"yPos":-897},"ID":1,"ParamActions":[],"TMPFontGUID":null,"Text":"Huh?","parentUIDs":[0],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":8}],"EditorInfo":{"isRoot":false,"xPos":-10.75,"yPos":-449},"ID":5,"ParamActions":[],"TMPFontGUID":null,"Text":"I''m
    interested to find out more.","parentUIDs":[4],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":9}],"EditorInfo":{"isRoot":false,"xPos":222.25,"yPos":-447},"ID":6,"ParamActions":[],"TMPFontGUID":null,"Text":"It''s
    beautiful. I can really feel the emotion behind every piece.","parentUIDs":[4],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":10}],"EditorInfo":{"isRoot":false,"xPos":462.25,"yPos":-447},"ID":7,"ParamActions":[],"TMPFontGUID":null,"Text":"Interesting.
    Though sometimes I feel like we romanticize the past and forget the present.","parentUIDs":[4],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":16}],"EditorInfo":{"isRoot":false,"xPos":218.75,"yPos":-71},"ID":15,"ParamActions":[],"TMPFontGUID":null,"Text":"Huh?","parentUIDs":[11],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":20}],"EditorInfo":{"isRoot":false,"xPos":224.75,"yPos":272},"ID":19,"ParamActions":[],"TMPFontGUID":null,"Text":"You
    know what, it''s okay. Have a lovely day.","parentUIDs":[17],"SpeechUID":-1}],"Parameters":[],"SpeechNodes":[{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":1}],"EditorInfo":{"isRoot":true,"xPos":191.25,"yPos":-1025},"ID":0,"ParamActions":[],"TMPFontGUID":null,"Text":"(muttering
    under breath)","parentUIDs":[],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Sally","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":3}],"EditorInfo":{"isRoot":false,"xPos":186.75,"yPos":-809},"ID":2,"ParamActions":[],"TMPFontGUID":null,"Text":"Oh!
    Didn''t see you there, my bad.","parentUIDs":[1],"AdvanceDialogueAutomatically":true,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Sally","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0.1,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":4}],"EditorInfo":{"isRoot":false,"xPos":189.75,"yPos":-691},"ID":3,"ParamActions":[],"TMPFontGUID":null,"Text":"I
